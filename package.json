{
  "name": "mashu-notes",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "麻薯 — 本地优先的生活记录 + Markdown 笔记本：饮食、健康、收支、日记连成一张可自由编辑的图，内置不联网的本地助手。",
  "license": "MIT",
  "keywords": [
    "life-log",
    "journal",
    "finance",
    "health",
    "markdown",
    "notes",
    "local-first",
    "agent",
    "obsidian-alternative",
    "pwa"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "share": "node scripts/serve.mjs",
    "icons": "python3 scripts/make_icons.py",
    "screenshots": "node scripts/screenshots.mjs",
    "qr": "node scripts/qr.mjs",
    "splash": "python3 scripts/make_splash.py"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frank-max610/mashu-notes.git"
  }
}
